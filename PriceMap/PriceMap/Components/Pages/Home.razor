@page "/"
@inject PythonRunner PythonRunner
@rendermode RenderMode.InteractiveServer
@using PriceMap.Model.Sanga

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<button @onclick="RunPythonScript">Run Script</button>

<p>@resultString</p>

@code{
    private List<SangaResponse> result;
    private string resultString;
    private async Task RunPythonScript()
    {
        try
        {
            resultString = await Task.Run(( ) => PythonRunner.RunScriptAsync("./Python/SangaCrawling.py"));
            Console.WriteLine(resultString);
            // result = await Task.Run(() => PythonRunner.RunScriptListAsync<SangaResponse>("./Python/SangaCrawling.py"));
        }
        catch (Exception ex)
        {
        }

    }
}
